# Copy to .env and fill in. Never commit .env.
# Leave a system's values BLANK to run it in mock mode.
# JML_MODE: auto (live where creds exist, else mock) | mock | live
JML_MODE=auto
JML_AUDIT_LOG=logs/jml_audit.jsonl

# --- Okta (free Integrator / Developer org) ---
# Token: Security > API > Tokens. Use a dedicated service admin scoped to Group Admin
# for the target groups, not a Super Admin token.
# e.g. https://integrator-1234567.okta.com  (no -admin)
OKTA_ORG_URL=
OKTA_API_TOKEN=

# --- Google Workspace (Business trial) ---
# Service account JSON with domain-wide delegation for scopes:
#   https://www.googleapis.com/auth/admin.directory.user
#   https://www.googleapis.com/auth/admin.directory.user.security
# e.g. C:\keys\service-account.json  and  admin@yourdomain.com
GWS_SERVICE_ACCOUNT_FILE=
GWS_ADMIN_SUBJECT=
GWS_DEFAULT_ORG_UNIT=/

# --- 1Password Business (trial) via SCIM Bridge ---
# e.g. https://scim.yourdomain.com
OP_SCIM_BRIDGE_URL=
OP_SCIM_TOKEN=

# --- Jamf Pro (mocked unless all three are set) ---
JAMF_URL=
JAMF_CLIENT_ID=
JAMF_CLIENT_SECRET=

# --- Alerting: Slack first, SMTP fallback ---
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
